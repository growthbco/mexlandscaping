# Web3Forms access key — get a free key at https://web3forms.com
# (associate it with team@mexlandscaping.com so leads land in that inbox).
PUBLIC_WEB3FORMS_KEY=

# --- Mini CRM (Lead Desk at /crm/) — set these in Vercel project env vars ---
# Postgres connection string. Auto-injected when the Neon integration is
# attached in Vercel > Storage. No manual value needed if using that.
DATABASE_URL=
# Login password for /crm/ and secret for signing session cookies.
CRM_PASSWORD=
CRM_SECRET=
# Shared secret for the LSA inbound-email webhook:
# POST /api/lsa-inbound/?key=<this value>
LSA_WEBHOOK_SECRET=
# HighLevel Private Integration token (Settings > Private Integrations,
# contacts write scope) for the Mex Landscaping sub-account.
HIGHLEVEL_API_KEY=
HIGHLEVEL_LOCATION_ID=ezvy5zMpXq8xZhPGDLLf
# Telegram bot (already set in Vercel for the website form) — reused by the CRM.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=your-web3forms-access-key
